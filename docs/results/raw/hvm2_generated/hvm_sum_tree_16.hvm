@main = x
  & 0 ~ $([+] $(1 t0_0))
  & 2 ~ $([+] $(3 t0_1))
  & 4 ~ $([+] $(5 t0_2))
  & 6 ~ $([+] $(7 t0_3))
  & 8 ~ $([+] $(9 t0_4))
  & 10 ~ $([+] $(11 t0_5))
  & 12 ~ $([+] $(13 t0_6))
  & 14 ~ $([+] $(15 t0_7))
  & t0_0 ~ $([+] $(t0_1 t1_0))
  & t0_2 ~ $([+] $(t0_3 t1_1))
  & t0_4 ~ $([+] $(t0_5 t1_2))
  & t0_6 ~ $([+] $(t0_7 t1_3))
  & t1_0 ~ $([+] $(t1_1 t2_0))
  & t1_2 ~ $([+] $(t1_3 t2_1))
  & t2_0 ~ $([+] $(t2_1 x))
